{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lancer server.js",
            "type": "shell",
            "command": "node server.js",
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^([^\\s].*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Lancement",
                    "endsPattern": "^✅ Serveur lancé"
                }
            }
        }
    ]
}
